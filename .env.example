# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings — use the publishable/anon key only in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret; NEVER prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (server-only; configure in Phase 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=media
R2_PUBLIC_BASE_URL=

# Optional integrations (later phases)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ID=
SENTRY_DSN=